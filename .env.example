# ==============================================================================
# ORCA Server Environment Configuration
# ==============================================================================

# Server Network & Runtime
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*

# Supabase Foundation (Phase 4)
# Current Key Model:
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# Legacy Supabase Key Names (Supported for backward compatibility):
# SUPABASE_ANON_KEY=your_legacy_anon_jwt_here
# SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_jwt_here
